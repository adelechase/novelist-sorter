{
  "manifest_version": 2,
  "name": "NoveList Series Companion",
  "version": "1.0.0",
  "description": "Checks NoveList and Goodreads series metadata for the NoveList sorter.",
  "permissions": ["https://research.ebsco.com/*", "https://www.goodreads.com/*", "https://goodreads.com/*"],
  "background": {"scripts": ["series-source.js", "background.js"]},
  "content_scripts": [{"matches": ["https://research.ebsco.com/*"], "js": ["bridge.js"]}],
  "browser_specific_settings": {"gecko": {"id": "novelist-series-companion@adelechase.github.io", "data_collection_permissions": {"required": ["none"]}}}
}
